# Copy this file to .env and fill in your own values.
# .env is ignored by git; never commit real values.

# Port the Express server listens on (Render sets this itself in production)
PORT=3000

# "development" on your PC, "production" on Render
NODE_ENV=development

# MongoDB Atlas connection string for the least-privilege app user (SETUP_GUIDE Part 4)
# Format: mongodb+srv://unilearnApp:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Websites allowed to call the API, comma-separated (no spaces, no trailing slash).
# On your PC: the two local addresses. On Render: only https://<your-domain>.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Clerk keys (SETUP_GUIDE Part 5). Clerk Dashboard → API keys.
# The publishable key is public; the SECRET key must never leave the server.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email domains admins may invite (D23), comma-separated, no "@". Empty = nobody can be invited.
# Example: students.myuni.edu,myuni.edu
ALLOWED_EMAIL_DOMAIN=

# Where invitation links send people (the React app). On Render: https://<your-domain>
APP_URL=http://localhost:5173

# AES-256 key that encrypts every stored PDF (D38, SETUP_GUIDE 6.9). 64 hex characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy in your password manager: if this key is lost, the stored PDFs can't be read again.
# Your PC and Render must use the SAME key if they share the same database.
FILE_ENCRYPTION_KEY=

# --- Production only (Render). Leave these empty on your PC. ---

# Secret header value that Cloudflare adds to every request (SETUP_GUIDE 6.3 and 7.8).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORIGIN_SECRET=
# Only while changing the secret: the old value goes here (SETUP_GUIDE 7.12)
ORIGIN_SECRET_OLD=

# How many proxies (Cloudflare + Render) sit in front of Express. 0 on your PC.
# The right number on Render is proven with the IP check (SETUP_GUIDE 7.10).
TRUST_PROXY_HOPS=0

# true = log each visitor's IP next to the proxy headers. Only while checking TRUST_PROXY_HOPS.
LOG_IP_CHECK=false
