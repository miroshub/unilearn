# Copy this file to .env and fill in your own values.
# .env is ignored by git; never commit real values.

# Port the Express server listens on (Render sets this itself in production)
PORT=3000

# "development" on your PC, "production" on Render
NODE_ENV=development

# MongoDB Atlas connection string for the least-privilege app user (SETUP_GUIDE Part 4)
# Format: mongodb+srv://unilearnApp:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Websites allowed to call the API, comma-separated (no spaces, no trailing slash).
# On your PC: the two local addresses. On Render: only https://<your-domain>.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
